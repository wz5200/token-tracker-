# Etherscan 系免费 Key（一把通用）：https://etherscan.io/register 注册后在 API Keys 页获取
# 覆盖 BSC（BscScan）与 World Chain（Worldscan），经 Etherscan V2 统一接口调用
ETHERSCAN_API_KEY=
# 兼容旧变量：只填 BSCSCAN_API_KEY 也可（仅 BSC 生效）
BSCSCAN_API_KEY=
# 可选：自建 BSC RPC（默认用官方公开节点）
BSC_RPC_URL=https://bsc-dataseed.binance.org
# 可选：World Chain RPC（默认用公开节点）
WORLDCHAIN_RPC_URL=https://worldchain.drpc.org
# 可选：Solana RPC（默认用官方公开节点；从机房 IP 可能被限流，
# 此时可换 Helius 等免费节点：https://www.helius.dev 注册获取）
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
PORT=8080
